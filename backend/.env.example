# ==========================================
# Aegisflow Workflow Engine Configuration
# ==========================================

# Server & Networking
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (MongoDB Atlas or Local MongoDB)
# Leave blank to run in isolated in-memory demo mode
MONGODB_URI=mongodb://localhost:27017/aegisflow

# Security & Cryptographic Salts
API_KEY_PEPPER=aegisflow-secret-key-12345
AUTH_SECRET=aegisflow-login-secret-67890

# Security Enforcement
# Set to 'true' to strictly enforce API key headers on all protected endpoints
ENFORCE_API_KEYS=false