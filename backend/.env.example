PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Optional. Without this, the API runs in demo memory mode and data resets on restart.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/flowpilot?retryWrites=true&w=majority
# Set a long random value for production deployments.
API_KEY_PEPPER=replace-with-a-long-random-secret
