PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Optional. Without this, the API runs in demo memory mode and data resets on restart.
MONGODB_URI=mongodb://127.0.0.1:27017/flowpilot
# Set a long random value for production deployments.
API_KEY_PEPPER=replace-with-a-long-random-secret
# Secret used to sign login session tokens. Set a long random value in production.
AUTH_SECRET=replace-with-another-long-random-secret
